{
  "name": "Job Alerts \u2014 Parts & Overtime",
  "description": "Triggers a WhatsApp alert when a job is marked as Parts Required or Wrong Parts, or when a job finishes after 17:30 (overtime).",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"parts_required\" or .trigger.data.status == \"wrong_parts_supplied\" or .trigger.data.status == \"faulty_parts_supplied\" or .trigger.data.status == \"missing_stock\" or .trigger.data.status == \"non_conformance\" or .trigger.data.status == \"completed_first_visit\" or .trigger.data.status == \"completed_return_visit\" or .trigger.data.status == \"completed\") or (.trigger.data.is_overtime == true)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Job"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "job_alerts_parts_overtime",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "jobAlerts",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "jobAlerts"
  }
}